# Copy this file to .env and fill in your key. Do not commit .env to git.
# OPENAI_API_KEY=sk-your-openai-api-key-here

OPENAI_API_KEY=

# Port for the Flask app (default 5000). Open http://127.0.0.1:<PORT>/
PORT=5000

# Optional: email (for "send absentees to my email" in chat). Set Report recipient email in Settings.
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=1
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-password
# MAIL_FROM=your-email@gmail.com
