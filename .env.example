# Copy this file to .env and fill in your key. Do not commit .env to git.
# OPENAI_API_KEY=sk-your-openai-api-key-here

OPENAI_API_KEY=

# Port for the Flask app (default 5000). Open http://127.0.0.1:<PORT>/
PORT=5000

# Database (default: SQLite in project folder). On Render, set SQLITE_PATH=/data/ai_system.db after adding a Persistent Disk mounted at /data.
# SQLITE_PATH=/data/ai_system.db

# Use only MySQL (no SQLite)
# USE_SQLITE=0
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=your-mysql-password
# MYSQL_DATABASE=ai_system

# Optional: email (for "send absentees to my email" in chat). Set Report recipient email in Settings.
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=1
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-password
# MAIL_FROM=your-email@gmail.com
# After setting these, send a demo email: POST /api/reports/send-demo-email with JSON {"email": "you@example.com"}
